rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid
        && request.auth.token.email in ['keeshehenkamp@gmail.com', 'keesjes44@gmail.com'];
    }
    // Samen rijden: iedereen die met Google is ingelogd mag een groepsrit maken, lezen en meedoen.
    // Er staat alleen een voornaam, een route en de plek op de weg in; elke rijder schrijft alleen zijn eigen plek.
    match /samen/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.host == request.auth.uid;
      allow update: if request.auth != null && resource.data.host == request.auth.uid;
      match /rijders/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
