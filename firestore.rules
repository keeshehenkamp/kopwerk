rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Ieder account ziet en schrijft alleen zijn eigen gegevens: users/{uid} (instellingen en schema),
    // users/{uid}/rides en users/{uid}/streams. Verwijderen mag ook (account verwijderen in Profiel).
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
    // Samen rijden: iedereen die is ingelogd mag een groepsrit maken, lezen en meedoen.
    // Er staat alleen een voornaam, een route en de plek op de weg in; elke rijder schrijft alleen zijn eigen plek.
    match /samen/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.host == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.host == request.auth.uid;
      match /rijders/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
